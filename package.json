{
  "name": "@bill9109/dsh-web-ui-notify",
  "version": "0.1.2",
  "description": "审批/提问/轮次完成桌面通知：DSH 需要人工确认权限、或者一轮干完了，而你在浏览其他标签页时，弹出系统通知",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill9109/dsh-web-ui-notify.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
